{
  "name": "@datacenter-tycoon/server",
  "version": "0.1.0",
  "description": "Backend for scoring, leaderboards, and multiplayer.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "build:deploy": "npm run build -w @datacenter-tycoon/game-logic && npm run build",
    "check:migrations": "bun run src/db/check-migrations.ts",
    "dev": "bun run --watch src/index.ts",
    "migrate": "bun run src/db/migrate.ts",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:ci": "rm -rf coverage && bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage --reporter=junit --reporter-outfile=coverage/junit.xml",
    "clean": "rm -rf dist *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@datacenter-tycoon/game-logic": "*",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
