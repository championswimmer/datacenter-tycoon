# Core HTTP settings
HOST=0.0.0.0
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_VERSION=0.1.0

# Database
# `npm run migrate -w @datacenter-tycoon/server` and `npm run dev:server`
# resolve the same provider target:
# - set DATABASE_URL for production/staging or local Postgres overrides;
# - otherwise development falls back to file-backed PGlite.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Optional abuse-resistance tuning
BACKEND_RATE_LIMIT_WINDOW_MS=1000
BACKEND_RATE_LIMIT_MAX_REQUESTS=10
PLAYER_REGISTRATION_RATE_LIMIT_WINDOW_MS=60000
PLAYER_REGISTRATION_RATE_LIMIT_MAX_REQUESTS=10
LEADERBOARD_SUBMISSION_RATE_LIMIT_WINDOW_MS=1000
LEADERBOARD_SUBMISSION_RATE_LIMIT_MAX_REQUESTS=1

# Verified leaderboard replay protocol
LEADERBOARD_VERIFICATION_PROTOCOL_VERSION=verified-run-v1
LEADERBOARD_VERIFICATION_RULESET_ID=leaderboard-ruleset-v1
LEADERBOARD_VERIFICATION_MAX_TICK_DELTA=15
LEADERBOARD_VERIFICATION_MAX_ACTION_COUNT=1024
LEADERBOARD_VERIFICATION_MAX_REQUEST_BODY_BYTES=262144
