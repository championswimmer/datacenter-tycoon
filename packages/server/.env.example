# Core HTTP settings
HOST=0.0.0.0
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_VERSION=0.1.0

# Database
# `npm run migrate -w @datacenter-tycoon/server` and `npm run dev:server`
# resolve the same provider target:
# - set DATABASE_URL for production/staging or local Postgres overrides;
# - otherwise development falls back to file-backed PGlite.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Optional abuse-resistance tuning
PLAYER_REGISTRATION_RATE_LIMIT_WINDOW_MS=60000
PLAYER_REGISTRATION_RATE_LIMIT_MAX_REQUESTS=10
LEADERBOARD_SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
LEADERBOARD_SUBMISSION_RATE_LIMIT_MAX_REQUESTS=120
