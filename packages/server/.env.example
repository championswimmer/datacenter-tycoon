# Core HTTP settings
HOST=0.0.0.0
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_VERSION=0.1.0

# Database
# Production/staging should set DATABASE_URL to a real Postgres connection string.
# Local development can omit DATABASE_URL and use file-backed PGlite instead.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Optional abuse-resistance tuning
PLAYER_REGISTRATION_RATE_LIMIT_WINDOW_MS=60000
PLAYER_REGISTRATION_RATE_LIMIT_MAX_REQUESTS=10
LEADERBOARD_SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
LEADERBOARD_SUBMISSION_RATE_LIMIT_MAX_REQUESTS=120
