{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["../../assets/*"],
      "@datacenter-tycoon/web": ["../web/src/index.ts"],
      "@datacenter-tycoon/web/*": ["../web/src/*"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],
    "composite": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../game-logic" },
    { "path": "../web" }
  ]
}
