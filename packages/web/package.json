{
  "name": "@datacenter-tycoon/web",
  "version": "0.1.0",
  "description": "Web frontend for Datacenter Tycoon — React 18 + Vite, neon control center theme.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:ci": "mkdir -p coverage && vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/junit.xml",
    "test:watch": "vitest",
    "perf:baseline": "vitest run src/performance/perfBaseline.test.tsx",
    "perf:budgets": "npm run build && node ./scripts/checkPerfBudgets.mjs",
    "perf:budgets:strict": "npm run build && node ./scripts/checkPerfBudgets.mjs --strict",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@datacenter-tycoon/game-logic": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.3"
  }
}
