# Web online API target
# Local development can omit this because the app defaults to http://localhost:3000.
# Repository production builds default to the live Railway API via .env.production.
# Override this locally only if you need a different staging/production backend.
# Leave it blank only if you intentionally want a local-only/offline web build.
VITE_API_BASE_URL=https://dctycoon-api-production.up.railway.app
