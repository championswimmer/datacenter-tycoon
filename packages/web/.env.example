# Web online API target
# Local development can omit this because the app defaults to http://localhost:3000.
# Production builds use the BACKEND_API_URL constant in src/online/backend.ts (v1 = TS server, v2 = Go server).
# Set this only to override the target locally or at build time.
# VITE_API_BASE_URL=https://dctycoon-api-v2-production.up.railway.app
